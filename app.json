{
  "expo": {
    "name": "Tbilisi koloriti",
    "slug": "tbilisi-koloriti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tbilisikoloriti",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D3557"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tbilisikoloriti.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is needed to photograph or record problems in the city.",
        "NSMicrophoneUsageDescription": "Microphone is needed to record video reports.",
        "NSLocationWhenInUseUsageDescription": "Location is needed to pin the exact spot of the reported problem.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Location is needed to pin the exact spot of the reported problem."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1D3557"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tbilisikoloriti.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-location",
      "expo-video",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_AFTER_EAS_INIT"
      }
    }
  }
}
